@inherits LayoutComponentBase
@using System.Globalization
@using ReQuantum.Shared.Services
@inject IStorage Storage

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">??</span>
</div>

@code {
    private const string LanguageStorageKey = "requantum.language";
    private static readonly HashSet<string> SupportedLanguages = ["zh-CN", "en-US"];
    private bool _languageInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _languageInitialized)
        {
            return;
        }

        _languageInitialized = true;
        try
        {
            var persistedLanguage = await Storage.GetAsync(LanguageStorageKey);
            if (string.IsNullOrWhiteSpace(persistedLanguage) || !SupportedLanguages.Contains(persistedLanguage))
            {
                return;
            }

            if (string.Equals(CultureInfo.CurrentUICulture.Name, persistedLanguage, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var culture = CultureInfo.GetCultureInfo(persistedLanguage);
            CultureInfo.DefaultThreadCurrentCulture = culture;
            CultureInfo.DefaultThreadCurrentUICulture = culture;
            CultureInfo.CurrentCulture = culture;
            CultureInfo.CurrentUICulture = culture;
            StateHasChanged();
        }
        catch (KeyNotFoundException)
        {
        }
        catch
        {
        }
    }
}
