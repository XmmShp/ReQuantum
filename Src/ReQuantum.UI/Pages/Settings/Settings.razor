@page "/settings"
@using System.Globalization
@using Microsoft.Extensions.Localization
@using ReQuantum.Application.Services.ZjuSso
@using ReQuantum.Application.Services.Pta
@using ReQuantum.Shared.Resources.Localization
@inject IZjuSsoService ZjuSsoService
@inject IPtaBrowserAuthService PtaAuthService
@inject IStringLocalizer<CalendarStrings> L
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>@L["MenuSettings"]</h3>

@* ZJU SSO 登录状态 *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@L["SettingsZjuSsoTitle"]</h5>
        @if (ZjuSsoService.IsAuthenticated)
        {
            <p class="text-success">@string.Format(L["SettingsLoggedInAs"], ZjuSsoService.Id)</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="ZjuSsoLogout">@L["SettingsLogout"]</button>
        }
        else
        {
            <p class="text-muted">@L["SettingsNotLoggedIn"]</p>
            <a href="zju-sso" class="btn btn-primary btn-sm">@L["SettingsGoToLogin"]</a>
        }
    </div>
</div>

@* PTA 登录状态 *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">PTA</h5>
        @if (PtaAuthService.IsAuthenticated)
        {
            <p class="text-success">@string.Format(L["SettingsLoggedInAs"], PtaAuthService.Email)</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="PtaLogout">@L["SettingsLogout"]</button>
        }
        else
        {
            <p class="text-muted">@L["SettingsNotLoggedIn"]</p>
            <a href="pta" class="btn btn-primary btn-sm">@L["SettingsGoToLogin"]</a>
        }
    </div>
</div>

@* 语言设置 *@
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@L["SettingsLanguage"]</h5>
        <select class="form-select" style="max-width: 200px;" @bind="_selectedLanguage" @bind:after="OnLanguageChangedAsync">
            <option value="zh-CN">@L["SettingsLanguageZhCn"]</option>
            <option value="en-US">@L["SettingsLanguageEnUs"]</option>
        </select>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@L["SettingsWeekStart"]</h5>
        <select class="form-select" style="max-width: 200px;" @bind="_selectedWeekStart" @bind:after="OnWeekStartChangedAsync">
            <option value="sunday">@L["SettingsWeekStartSunday"]</option>
            <option value="monday">@L["SettingsWeekStartMonday"]</option>
        </select>
    </div>
</div>

@code {
    private const string LanguageStorageKey = "requantum.language";
    private const string WeekStartStorageKey = "requantum.weekStart";
    private static readonly HashSet<string> SupportedLanguages = ["zh-CN", "en-US"];
    private static readonly HashSet<string> SupportedWeekStarts = ["sunday", "monday"];
    private string _selectedLanguage = CultureInfo.CurrentUICulture.Name;
    private string _selectedWeekStart = "sunday";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var persistedLanguage = await JS.InvokeAsync<string?>("localStorage.getItem", LanguageStorageKey);
            if (!string.IsNullOrWhiteSpace(persistedLanguage) && SupportedLanguages.Contains(persistedLanguage))
            {
                _selectedLanguage = persistedLanguage;
            }
            else if (!SupportedLanguages.Contains(_selectedLanguage))
            {
                _selectedLanguage = "zh-CN";
            }

            var persistedWeekStart = await JS.InvokeAsync<string?>("localStorage.getItem", WeekStartStorageKey);
            if (!string.IsNullOrWhiteSpace(persistedWeekStart) && SupportedWeekStarts.Contains(persistedWeekStart))
            {
                _selectedWeekStart = persistedWeekStart;
            }
        }
        catch
        {
            if (!SupportedLanguages.Contains(_selectedLanguage))
            {
                _selectedLanguage = "zh-CN";
            }

            _selectedWeekStart = "sunday";
        }
    }

    private void ZjuSsoLogout()
    {
        ZjuSsoService.Logout();
    }

    private void PtaLogout()
    {
        PtaAuthService.Logout();
    }

    private async Task OnLanguageChangedAsync()
    {
        if (!SupportedLanguages.Contains(_selectedLanguage))
        {
            _selectedLanguage = "zh-CN";
        }

        var culture = CultureInfo.GetCultureInfo(_selectedLanguage);
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;
        CultureInfo.CurrentCulture = culture;
        CultureInfo.CurrentUICulture = culture;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LanguageStorageKey, _selectedLanguage);
        }
        catch
        {
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task OnWeekStartChangedAsync()
    {
        if (!SupportedWeekStarts.Contains(_selectedWeekStart))
        {
            _selectedWeekStart = "sunday";
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", WeekStartStorageKey, _selectedWeekStart);
        }
        catch
        {
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}