@page "/courses-zju"
@using ReQuantum.Application.Models.CoursesZju
@using ReQuantum.Application.Services.CoursesZju
@inject ICoursesZjuService CoursesZjuService

<h3>学在浙大 - 待办事项</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="LoadTodoListAsync" disabled="@_isLoading">
        @(_isLoading ? "加载中..." : "刷新待办")
    </button>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_todoList is not null && _todoList.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>标题</th>
                    <th>课程</th>
                    <th>截止时间</th>
                    <th>类型</th>
                    <th>状态</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var todo in _todoList.OrderBy(t => t.EndTime))
                {
                    <tr class="@(todo.EndTime < DateTime.UtcNow ? "table-danger" : "")">
                        <td>@todo.Title</td>
                        <td>@todo.CourseName</td>
                        <td>@todo.EndTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@todo.Type</td>
                        <td>
                            @if (todo.IsLocked)
                            {
                                <span class="badge bg-secondary">已锁定</span>
                            }
                            else if (todo.EndTime < DateTime.UtcNow)
                            {
                                <span class="badge bg-danger">已过期</span>
                            }
                            else
                            {
                                <span class="badge bg-success">进行中</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!_isLoading && _todoList is not null)
{
    <p class="text-muted">暂无待办事项</p>
}

@code {
    private HashSet<CoursesZjuTodoDto>? _todoList;
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTodoListAsync();
    }

    private async Task LoadTodoListAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await CoursesZjuService.GetTodoListAsync();
        if (result.IsSuccess)
        {
            _todoList = result.Value;
        }
        else
        {
            _errorMessage = result.Message?.ToString();
            _todoList ??= [];
        }

        _isLoading = false;
    }
}