@page "/zju-sso"
@using Microsoft.Extensions.Localization
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Application.Services.ZjuSso
@inject IMutableZjuContext SsoService
@inject IStringLocalizer<ZjuSsoStrings> L

<PageTitle>@L["ZjuSso"]</PageTitle>

<div class="zju-sso-container">
    <div class="zju-sso-header">
        <h1>@L["ZjuSso"]</h1>
    </div>

    <div class="zju-sso-content">
        @if (SsoService.IsAuthenticated)
        {
            <div class="auth-status authenticated">
                <div class="status-icon"></div>
                <div class="status-info">
                    <p class="status-text">@L["LoggedInAs"]</p>
                    <p class="user-id">@SsoService.Id</p>
                </div>
                <button class="btn btn-outline-danger" @onclick="HandleLogout">@L["Logout"]</button>
            </div>
        }
        else
        {
            <div class="auth-status not-authenticated">
                <div class="status-icon"></div>
                <p class="status-text">@L["NotLoggedIn"]</p>
            </div>

            <div class="login-actions">
                <button class="btn btn-primary" @onclick="HandleBrowserLogin" disabled="@_isLoggingIn">
                    @if (_isLoggingIn)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        @(" ")
                    }
                    @L["BrowserLogin"]
                </button>

                <div class="manual-login">
                    <h4>@L["ManualLogin"]</h4>
                    <div class="form-group">
                        <label>@L["CookieValue"]</label>
                        <input type="text" class="form-control" @bind="_manualCookieValue"
                               placeholder="@L["CookieValuePlaceholder"]" />
                    </div>
                    <div class="form-group">
                        <label>@L["UserId"]</label>
                        <input type="text" class="form-control" @bind="_manualUserId"
                               placeholder="@L["UserIdPlaceholder"]" />
                    </div>
                    <button class="btn btn-secondary" @onclick="HandleManualLogin"
                            disabled="@(string.IsNullOrWhiteSpace(_manualCookieValue))">
                        @L["Login"]
                    </button>
                </div>
            </div>
        }

        @if (_progressMessages.Count > 0)
        {
            <div class="progress-log">
                <h4>@L["Progress"]</h4>
                @foreach (var msg in _progressMessages)
                {
                    <div class="progress-message">@msg</div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _isLoggingIn;
    private string _manualCookieValue = string.Empty;
    private string _manualUserId = string.Empty;
    private readonly List<string> _progressMessages = new();
    private CancellationTokenSource? _loginCancellationTokenSource;

    protected override void OnInitialized()
    {
        SsoService.OnLogin += OnAuthStateChanged;
        SsoService.OnLogout += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleBrowserLogin()
    {
        _isLoggingIn = true;
        _progressMessages.Clear();
        StateHasChanged();

        _loginCancellationTokenSource?.Cancel();
        _loginCancellationTokenSource?.Dispose();
        _loginCancellationTokenSource = new CancellationTokenSource();

        var result = await SsoService.AcquireSessionAsync(_loginCancellationTokenSource.Token);

        if (!result.IsSuccess)
        {
            _progressMessages.Add($" {result.Message}");
        }

        _isLoggingIn = false;
        StateHasChanged();
    }

    private void HandleManualLogin()
    {
        var userId = string.IsNullOrWhiteSpace(_manualUserId) ? "ZJU用户" : _manualUserId;
        var result = SsoService.Set(userId, _manualCookieValue);

        _progressMessages.Clear();
        _progressMessages.Add($" {result.Message}");

        _manualCookieValue = string.Empty;
        _manualUserId = string.Empty;
    }

    private void HandleLogout()
    {
        _loginCancellationTokenSource?.Cancel();
        SsoService.Logout();
        _progressMessages.Clear();
    }
}
