@page "/"
@using NOF.Contract
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Events
@using ReQuantum.Contract.Calendar.Notes
@using ReQuantum.Contract.Calendar.Todos
@inject IRequestSender RequestSender

<PageTitle>ReQuantum</PageTitle>

<h3>仪表盘</h3>

<div class="row">
    @* 近期日程 *@
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>近期日程</strong>
                <a href="calendar" class="btn btn-sm btn-outline-primary">查看全部</a>
            </div>
            <div class="card-body">
                @if (_recentEvents.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var evt in _recentEvents)
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-bold">@evt.Content.Split('\n')[0]</div>
                                <small class="text-muted">@evt.StartTime.ToString("MM-dd HH:mm") - @evt.EndTime.ToString("HH:mm")</small>
                                @if (!string.IsNullOrEmpty(evt.From))
                                {
                                    <span class="badge bg-info ms-1">@evt.From</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">暂无近期日程</p>
                }
            </div>
        </div>
    </div>

    @* 待办事项 *@
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>待办事项</strong>
                <a href="calendar" class="btn btn-sm btn-outline-primary">查看全部</a>
            </div>
            <div class="card-body">
                @if (_recentTodos.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var todo in _recentTodos)
                        {
                            <li class="list-group-item px-0">
                                <div class="@(todo.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                    @todo.Content
                                </div>
                                <small class="text-muted">截止: @todo.DueTime.ToString("MM-dd HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">暂无待办事项</p>
                }
            </div>
        </div>
    </div>

    @* 便签 *@
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>便签</strong>
                <a href="calendar" class="btn btn-sm btn-outline-primary">查看全部</a>
            </div>
            <div class="card-body">
                @if (_recentNotes.Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var note in _recentNotes)
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-bold">@note.Content</div>
                                <small class="text-muted">@note.CreatedAt.ToString("MM-dd HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">暂无便签</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<CalendarEvent> _recentEvents = [];
    private List<CalendarTodo> _recentTodos = [];
    private List<CalendarNote> _recentNotes = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadRecentItemsAsync();
    }

    private async Task LoadRecentItemsAsync()
    {
        var now = DateTime.Now;

        var eventsResult = await RequestSender.SendAsync(new GetAllEventsRequest());
        _recentEvents = (eventsResult.IsSuccess ? eventsResult.Value!.Events : [])
            .Where(e => e.StartTime.Date >= now.Date)
            .OrderBy(e => e.StartTime)
            .Take(5)
            .ToList();

        var todosResult = await RequestSender.SendAsync(new GetAllTodosRequest());
        _recentTodos = (todosResult.IsSuccess ? todosResult.Value!.Todos : [])
            .Where(t => !t.IsCompleted && t.DueTime >= now)
            .OrderBy(t => t.DueTime)
            .Take(5)
            .ToList();

        var notesResult = await RequestSender.SendAsync(new GetAllNotesRequest());
        _recentNotes = (notesResult.IsSuccess ? notesResult.Value!.Notes : [])
            .OrderByDescending(n => n.CreatedAt)
            .Take(5)
            .ToList();
    }
}
