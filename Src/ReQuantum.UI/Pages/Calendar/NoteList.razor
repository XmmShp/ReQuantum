@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Notes
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="note-list">
    <div class="list-header">
        <h4>@L["NoteList"]</h4>
        <button class="btn btn-sm btn-primary" @onclick="ShowAddNoteDialog">@L["AddNote"]</button>
    </div>

    <Modal Visible="isEditing" Title="@(editingId.HasValue ? L["Edit"] : L["AddNote"])" OnClose="CancelEdit">
        <ChildContent>
            <textarea class="form-control"
                      rows="4"
                      @bind="editingContent"
                      placeholder="@L["NoteContent"]"></textarea>
        </ChildContent>
        <Footer>
            <button class="btn btn-sm btn-primary" @onclick="SaveNoteAsync">@L["Save"]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
        </Footer>
    </Modal>

    <div class="list-content">
        @if (notes.Any())
        {
            @foreach (var note in notes)
            {
                var isConfirmingDelete = _pendingDeleteId == note.Id;
                var isDeleting = _deletingNoteIds.Contains(note.Id);
                <div class="note-item @(isDeleting ? "deleting" : string.Empty)" @key="note.Id">
                    <div class="note-info">
                        <div class="note-content">@note.Content</div>
                        <div class="note-created">
                            @string.Format(L["CreatedAt"], note.CreatedAt.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </div>
                    <div class="note-actions">
                        <button class="icon-btn edit-btn" title="@L["Edit"]" @onclick="() => EditNote(note)">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M4 20h4l10-10a2.12 2.12 0 0 0-3-3L5 17v3zM14 7l3 3" />
                            </svg>
                        </button>
                        <button class="icon-btn delete-btn @(isConfirmingDelete ? "confirm" : string.Empty)"
                                title="@(isConfirmingDelete ? L["ConfirmDelete"] : L["Delete"])"
                                @onclick="() => OnDeleteClickAsync(note.Id)"
                                disabled="@isDeleting">
                            @if (isConfirmingDelete)
                            {
                                <span class="delete-confirm-mark">?</span>
                            }
                            else
                            {
                                <svg class="trash-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M9 3.5a1 1 0 0 0-1 1V6H5a1 1 0 1 0 0 2h.56l.9 10.2A2 2 0 0 0 8.45 20h7.1a2 2 0 0 0 1.99-1.8l.9-10.2H19a1 1 0 1 0 0-2h-3V4.5a1 1 0 0 0-1-1H9Zm2 2h2V6h-2V5.5ZM8.46 8h7.08l-.88 10H9.34L8.46 8Zm2.04 1.5a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Zm3 0a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Z" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoNotes"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<CalendarNote> notes = new();
    private bool isEditing;
    private long? editingId;
    private string editingContent = string.Empty;
    private long? _pendingDeleteId;
    private readonly HashSet<long> _deletingNoteIds = [];
    private const int DeleteFadeOutDurationMs = 220;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        var result = await ReQuantumService.GetAllNotesAsync(new GetAllNotesRequest());
        notes = result.IsSuccess ? result.Value!.Notes : [];
        _pendingDeleteId = null;
        _deletingNoteIds.Clear();
    }

    private void ShowAddNoteDialog()
    {
        editingId = null;
        editingContent = string.Empty;
        isEditing = true;
    }

    private void EditNote(CalendarNote note)
    {
        editingId = note.Id;
        editingContent = note.Content;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = null;
        editingContent = string.Empty;
    }

    private async Task SaveNoteAsync()
    {
        var content = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        if (editingId.HasValue)
        {
            await ReQuantumService.UpdateNoteAsync(new UpdateNoteRequest(editingId.Value, content));
        }
        else
        {
            await ReQuantumService.AddNoteAsync(new AddNoteRequest(content));
        }

        CancelEdit();
        await LoadNotesAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task OnDeleteClickAsync(long id)
    {
        if (_deletingNoteIds.Contains(id))
        {
            return;
        }

        if (_pendingDeleteId != id)
        {
            _pendingDeleteId = id;
            return;
        }

        _pendingDeleteId = null;
        _deletingNoteIds.Add(id);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(DeleteFadeOutDurationMs);
        await DeleteNoteAsync(id);
        _deletingNoteIds.Remove(id);
    }

    private async Task DeleteNoteAsync(long id)
    {
        await ReQuantumService.RemoveNoteAsync(new RemoveNoteRequest(id));
        await LoadNotesAsync();
        await OnChanged.InvokeAsync();
    }
}
