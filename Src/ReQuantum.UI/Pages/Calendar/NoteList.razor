@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Notes
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="note-list">
    <div class="list-header">
        <h4>@L["NoteList"]</h4>
        <button class="add-btn" title="@L["AddNote"]" aria-label="@L["AddNote"]" @onclick="ShowAddNoteDialog">
            <img class="add-icon" src="_content/ReQuantum.UI/icons/plus.svg" alt="" aria-hidden="true" />
        </button>
    </div>

    <Modal Visible="_isEditing" Title="@(_editingId.HasValue ? L["Edit"] : L["AddNote"])" OnClose="CancelEdit" CloseOnBackdropClick="false">
        <ChildContent>
            <Message Text="@_formMessage" Variant="@_formMessageVariant" />
            <textarea class="form-control"
                      rows="4"
                      @bind="_editingContent"
                      placeholder="@L["NoteContent"]"></textarea>
        </ChildContent>
        <Footer>
            <button class="btn btn-sm btn-primary" @onclick="SaveNoteAsync">@L["Save"]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
        </Footer>
    </Modal>

    <div class="list-content">
        @if (_notes.Any())
        {
            @foreach (var note in _notes)
            {
                var isConfirmingDelete = PendingDeleteId == note.Id;
                var isDeleting = _deletingNoteIds.Contains(note.Id);
                <div class="note-item @(isDeleting ? "deleting" : string.Empty)" @key="note.Id">
                    <div class="note-info">
                        <div class="note-content">@note.Content</div>
                        <div class="note-created">
                            @string.Format(L["CreatedAt"], note.CreatedAt.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </div>
                    <div class="note-actions">
                        <button class="icon-btn edit-btn" title="@L["Edit"]" @onclick="() => EditNote(note)">
                            <img class="action-icon" src="_content/ReQuantum.UI/icons/edit.svg" alt="" aria-hidden="true" />
                        </button>
                        <button class="icon-btn delete-btn @(isConfirmingDelete ? "confirm" : string.Empty)"
                                title="@(isConfirmingDelete ? L["ConfirmDelete"] : L["Delete"])"
                                @onclick="() => OnDeleteClickAsync(note.Id)"
                                disabled="@isDeleting">
                            @if (isConfirmingDelete)
                            {
                                <span class="delete-confirm-mark">?</span>
                            }
                            else
                            {
                                <img class="trash-icon" src="_content/ReQuantum.UI/icons/trash.svg" alt="" aria-hidden="true" />
                            }
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoNotes"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public long? PendingDeleteId { get; set; }

    [Parameter]
    public EventCallback<long?> PendingDeleteIdChanged { get; set; }

    private List<CalendarNote> _notes = [];
    private bool _isEditing;
    private long? _editingId;
    private string _editingContent = string.Empty;
    private string? _formMessage;
    private string _formMessageVariant = "info";
    private readonly HashSet<long> _deletingNoteIds = [];
    private const int DeleteFadeOutDurationMs = 220;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        var result = await ReQuantumService.GetAllNotesAsync(new GetAllNotesRequest());
        _notes = result.IsSuccess ? result.Value!.Notes : [];
        _deletingNoteIds.Clear();
    }

    private void ShowAddNoteDialog()
    {
        _editingId = null;
        _editingContent = string.Empty;
        ClearFormMessage();
        _isEditing = true;
    }

    private void EditNote(CalendarNote note)
    {
        _editingId = note.Id;
        _editingContent = note.Content;
        ClearFormMessage();
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editingId = null;
        _editingContent = string.Empty;
        ClearFormMessage();
    }

    private async Task SaveNoteAsync()
    {
        ClearFormMessage();
        var content = _editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            SetFormMessage(L["ValidationRequiredNoteContent"], "error");
            return;
        }

        if (_editingId.HasValue)
        {
            await ReQuantumService.UpdateNoteAsync(new UpdateNoteRequest(_editingId.Value, content));
        }
        else
        {
            await ReQuantumService.AddNoteAsync(new AddNoteRequest(content));
        }

        CancelEdit();
        await LoadNotesAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task OnDeleteClickAsync(long id)
    {
        if (_deletingNoteIds.Contains(id))
        {
            return;
        }

        if (PendingDeleteId != id)
        {
            await PendingDeleteIdChanged.InvokeAsync(id);
            return;
        }

        await PendingDeleteIdChanged.InvokeAsync(null);
        _deletingNoteIds.Add(id);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(DeleteFadeOutDurationMs);
        await DeleteNoteAsync(id);
        _deletingNoteIds.Remove(id);
    }

    private async Task DeleteNoteAsync(long id)
    {
        await ReQuantumService.RemoveNoteAsync(new RemoveNoteRequest(id));
        await LoadNotesAsync();
        await OnChanged.InvokeAsync();
    }

    private void SetFormMessage(string text, string variant)
    {
        _formMessage = text;
        _formMessageVariant = variant;
    }

    private void ClearFormMessage()
    {
        _formMessage = null;
        _formMessageVariant = "info";
    }
}
