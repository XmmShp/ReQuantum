@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Todos
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="todo-list">
    <div class="list-header">
        <h4>@L["TodoList"]</h4>
        <button class="btn btn-sm btn-primary" @onclick="ShowAddTodoDialog">@L["AddTodo"]</button>
    </div>

    <Modal Visible="isEditing" Title="@(editingId.HasValue ? L["Edit"] : L["AddTodo"])" OnClose="CancelEdit">
        <ChildContent>
            <input class="form-control mb-2"
                   @bind="editingContent"
                   placeholder="@L["TodoContent"]" />
            <InputDate TValue="DateTime"
                       class="form-control mb-2"
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="editingDueTime" />
            @if (!editingId.HasValue)
            {
                <label class="form-check-label d-flex align-items-center gap-2 mb-2">
                    <input class="form-check-input" type="checkbox" @bind="editingIsCompletedForAdd" />
                    <span>@L["Completed"]</span>
                </label>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-sm btn-primary" @onclick="SaveTodoAsync">@L["Save"]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
        </Footer>
    </Modal>

    <div class="list-content">
        @if (todos.Any())
        {
            @foreach (var todo in todos)
            {
                var isConfirmingDelete = _pendingDeleteId == todo.Id;
                var isDeleting = _deletingTodoIds.Contains(todo.Id);
                <div class="todo-item @(todo.IsCompleted ? "completed" : "") @(isDeleting ? "deleting" : string.Empty)" @key="todo.Id">
                    <input type="checkbox" 
                           checked="@todo.IsCompleted" 
                           @onchange="() => ToggleTodo(todo.Id)" />
                    <div class="todo-info">
                        <div class="todo-content">@todo.Content</div>
                        <div class="todo-due-time">
                            @string.Format(L["DueTime"], todo.DueTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </div>
                    <div class="todo-actions">
                        <button class="icon-btn edit-btn" title="@L["Edit"]" @onclick="() => EditTodo(todo)">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M4 20h4l10-10a2.12 2.12 0 0 0-3-3L5 17v3zM14 7l3 3" />
                            </svg>
                        </button>
                        <button class="icon-btn delete-btn @(isConfirmingDelete ? "confirm" : string.Empty)"
                                title="@(isConfirmingDelete ? L["ConfirmDelete"] : L["Delete"])"
                                @onclick="() => OnDeleteClickAsync(todo.Id)"
                                disabled="@isDeleting">
                            @if (isConfirmingDelete)
                            {
                                <span class="delete-confirm-mark">?</span>
                            }
                            else
                            {
                                <svg class="trash-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M9 3.5a1 1 0 0 0-1 1V6H5a1 1 0 1 0 0 2h.56l.9 10.2A2 2 0 0 0 8.45 20h7.1a2 2 0 0 0 1.99-1.8l.9-10.2H19a1 1 0 1 0 0-2h-3V4.5a1 1 0 0 0-1-1H9Zm2 2h2V6h-2V5.5ZM8.46 8h7.08l-.88 10H9.34L8.46 8Zm2.04 1.5a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Zm3 0a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Z" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoTodos"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateOnly SelectedDate { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<CalendarTodo> todos = new();
    private bool isEditing;
    private long? editingId;
    private string editingContent = string.Empty;
    private DateTime editingDueTime = DateTime.Now;
    private bool editingIsCompletedForAdd;
    private long? _pendingDeleteId;
    private readonly HashSet<long> _deletingTodoIds = [];
    private const int DeleteFadeOutDurationMs = 220;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTodosAsync();
    }

    private async Task LoadTodosAsync()
    {
        var result = await ReQuantumService.GetTodosByDateAsync(new GetTodosByDateRequest(SelectedDate));
        todos = result.IsSuccess ? result.Value!.Todos : [];
        _pendingDeleteId = null;
        _deletingTodoIds.Clear();
    }

    private void ShowAddTodoDialog()
    {
        editingId = null;
        editingContent = string.Empty;
        editingDueTime = SelectedDate.ToDateTime(new TimeOnly(9, 0));
        editingIsCompletedForAdd = false;
        isEditing = true;
    }

    private void EditTodo(CalendarTodo todo)
    {
        editingId = todo.Id;
        editingContent = todo.Content;
        editingDueTime = todo.DueTime;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = null;
        editingContent = string.Empty;
        editingDueTime = DateTime.Now;
        editingIsCompletedForAdd = false;
    }

    private async Task SaveTodoAsync()
    {
        var content = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        if (editingId.HasValue)
        {
            await ReQuantumService.UpdateTodoAsync(new UpdateTodoRequest(editingId.Value, content, editingDueTime));
        }
        else
        {
            await ReQuantumService.AddTodoAsync(new AddTodoRequest(content, editingDueTime, editingIsCompletedForAdd));
        }

        CancelEdit();
        await LoadTodosAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ToggleTodo(long id)
    {
        await ReQuantumService.ToggleTodoCompleteAsync(new ToggleTodoCompleteRequest(id));
        await LoadTodosAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task OnDeleteClickAsync(long id)
    {
        if (_deletingTodoIds.Contains(id))
        {
            return;
        }

        if (_pendingDeleteId != id)
        {
            _pendingDeleteId = id;
            return;
        }

        _pendingDeleteId = null;
        _deletingTodoIds.Add(id);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(DeleteFadeOutDurationMs);
        await DeleteTodoAsync(id);
        _deletingTodoIds.Remove(id);
    }

    private async Task DeleteTodoAsync(long id)
    {
        await ReQuantumService.RemoveTodoAsync(new RemoveTodoRequest(id));
        await LoadTodosAsync();
        await OnChanged.InvokeAsync();
    }
}
