@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Todos
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="todo-list">
    <div class="list-header">
        <h4>@L["TodoList"]</h4>
        <button class="btn btn-sm btn-primary" @onclick="ShowAddTodoDialog">@L["AddTodo"]</button>
    </div>

    @if (isEditing)
    {
        <div class="todo-editor mb-2">
            <input class="form-control mb-2"
                   @bind="editingContent"
                   placeholder="@L["TodoContent"]" />
            <input class="form-control mb-2"
                   type="datetime-local"
                   @bind-value="editingDueTime"
                   @bind-value:format="yyyy-MM-ddTHH:mm" />
            @if (!editingId.HasValue)
            {
                <label class="form-check-label d-flex align-items-center gap-2 mb-2">
                    <input class="form-check-input" type="checkbox" @bind="editingIsCompletedForAdd" />
                    <span>@L["Completed"]</span>
                </label>
            }
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary" @onclick="SaveTodoAsync">@L["Save"]</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
            </div>
        </div>
    }

    <div class="list-content">
        @if (todos.Any())
        {
            @foreach (var todo in todos)
            {
                <div class="todo-item @(todo.IsCompleted ? "completed" : "")">
                    <input type="checkbox" 
                           checked="@todo.IsCompleted" 
                           @onchange="() => ToggleTodo(todo.Id)" />
                    <div class="todo-info">
                        <div class="todo-content">@todo.Content</div>
                        <div class="todo-due-time">
                            @string.Format(L["DueTime"], todo.DueTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </div>
                    <div class="todo-actions">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditTodo(todo)">@L["Edit"]</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTodo(todo.Id)">@L["Delete"]</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoTodos"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateOnly SelectedDate { get; set; }

    private List<CalendarTodo> todos = new();
    private bool isEditing;
    private long? editingId;
    private string editingContent = string.Empty;
    private DateTime editingDueTime = DateTime.Now;
    private bool editingIsCompletedForAdd;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTodosAsync();
    }

    private async Task LoadTodosAsync()
    {
        var result = await ReQuantumService.GetTodosByDateAsync(new GetTodosByDateRequest(SelectedDate));
        todos = result.IsSuccess ? result.Value!.Todos : [];
    }

    private void ShowAddTodoDialog()
    {
        editingId = null;
        editingContent = string.Empty;
        editingDueTime = DateTime.Now;
        editingIsCompletedForAdd = false;
        isEditing = true;
    }

    private void EditTodo(CalendarTodo todo)
    {
        editingId = todo.Id;
        editingContent = todo.Content;
        editingDueTime = todo.DueTime;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = null;
        editingContent = string.Empty;
        editingDueTime = DateTime.Now;
        editingIsCompletedForAdd = false;
    }

    private async Task SaveTodoAsync()
    {
        var content = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        if (editingId.HasValue)
        {
            await ReQuantumService.UpdateTodoAsync(new UpdateTodoRequest(editingId.Value, content, editingDueTime));
        }
        else
        {
            await ReQuantumService.AddTodoAsync(new AddTodoRequest(content, editingDueTime, editingIsCompletedForAdd));
        }

        CancelEdit();
        await LoadTodosAsync();
    }

    private async Task ToggleTodo(long id)
    {
        await ReQuantumService.ToggleTodoCompleteAsync(new ToggleTodoCompleteRequest(id));
        await LoadTodosAsync();
    }

    private async Task DeleteTodo(long id)
    {
        await ReQuantumService.RemoveTodoAsync(new RemoveTodoRequest(id));
        await LoadTodosAsync();
    }
}
