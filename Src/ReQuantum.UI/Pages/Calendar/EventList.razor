@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Events
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="event-list">
    <div class="list-header">
        <h4>@L["EventList"]</h4>
        <button class="btn btn-sm btn-primary" @onclick="ShowAddEventDialog">@L["AddEvent"]</button>
    </div>

    <Modal Visible="isEditing" Title="@(editingId.HasValue ? L["Edit"] : L["AddEvent"])" OnClose="CancelEdit">
        <ChildContent>
            <input class="form-control mb-2"
                   @bind="editingContent"
                   placeholder="@L["Title"]" />
            <InputDate TValue="DateTime"
                       class="form-control mb-2"
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="editingStartTime" />
            <InputDate TValue="DateTime"
                       class="form-control mb-2"
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="editingEndTime" />
            <input class="form-control mb-2"
                   @bind="editingNote"
                   placeholder="@L["Note"]" />
        </ChildContent>
        <Footer>
            <button class="btn btn-sm btn-primary" @onclick="SaveEventAsync">@L["Save"]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
        </Footer>
    </Modal>

    <div class="list-content">
        @if (events.Any())
        {
            @foreach (var evt in events)
            {
                <div class="event-item">
                    <div class="event-info">
                        <div class="event-title">@evt.Content</div>
                        <div class="event-time">
                            @evt.StartTime.ToString("yyyy-MM-dd HH:mm") - @evt.EndTime.ToString("HH:mm")
                        </div>
                        @if (!string.IsNullOrEmpty(evt.Note))
                        {
                            <div class="event-note">@evt.Note</div>
                        }
                        @if (!string.IsNullOrEmpty(evt.From))
                        {
                            <div class="event-from">@string.Format(L["Source"], evt.From)</div>
                        }
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditEvent(evt)">@L["Edit"]</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEvent(evt.Id)">@L["Delete"]</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoEvents"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateOnly SelectedDate { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<CalendarEvent> events = new();
    private bool isEditing;
    private long? editingId;
    private string editingContent = string.Empty;
    private DateTime editingStartTime = DateTime.Now;
    private DateTime editingEndTime = DateTime.Now.AddHours(1);
    private string editingNote = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var result = await ReQuantumService.GetEventsByDateAsync(new GetEventsByDateRequest(SelectedDate));
        events = result.IsSuccess ? result.Value!.Events : [];
    }

    private void ShowAddEventDialog()
    {
        editingId = null;
        editingContent = string.Empty;
        editingStartTime = SelectedDate.ToDateTime(new TimeOnly(9, 0));
        editingEndTime = SelectedDate.ToDateTime(new TimeOnly(10, 0));
        editingNote = string.Empty;
        isEditing = true;
    }

    private void EditEvent(CalendarEvent evt)
    {
        editingId = evt.Id;
        editingContent = evt.Content;
        editingStartTime = evt.StartTime;
        editingEndTime = evt.EndTime;
        editingNote = evt.Note;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = null;
        editingContent = string.Empty;
        editingStartTime = DateTime.Now;
        editingEndTime = DateTime.Now.AddHours(1);
        editingNote = string.Empty;
    }

    private async Task SaveEventAsync()
    {
        var content = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        if (editingEndTime <= editingStartTime)
        {
            return;
        }

        var note = editingNote.Trim();
        if (editingId.HasValue)
        {
            await ReQuantumService.UpdateEventAsync(new UpdateEventRequest(editingId.Value, content, editingStartTime, editingEndTime, note));
        }
        else
        {
            await ReQuantumService.AddEventAsync(new AddEventRequest(content, editingStartTime, editingEndTime, note, "manual", 0));
        }

        CancelEdit();
        await LoadEventsAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteEvent(long id)
    {
        await ReQuantumService.RemoveEventAsync(new RemoveEventRequest(id));
        await LoadEventsAsync();
        await OnChanged.InvokeAsync();
    }
}
