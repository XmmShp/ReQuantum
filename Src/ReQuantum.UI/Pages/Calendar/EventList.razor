@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@using ReQuantum.Contract.Calendar.Events
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="event-list">
    <div class="list-header">
        <h4>@L["EventList"]</h4>
        <button class="btn btn-sm btn-primary" @onclick="ShowAddEventDialog">@L["AddEvent"]</button>
    </div>

    <Modal Visible="isEditing" Title="@(editingId.HasValue ? L["Edit"] : L["AddEvent"])" OnClose="CancelEdit">
        <ChildContent>
            <input class="form-control mb-2"
                   @bind="editingContent"
                   placeholder="@L["Title"]" />
            <InputDate TValue="DateTime"
                       class="form-control mb-2"
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="editingStartTime" />
            <InputDate TValue="DateTime"
                       class="form-control mb-2"
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="editingEndTime" />
            <input class="form-control mb-2"
                   @bind="editingNote"
                   placeholder="@L["Note"]" />
        </ChildContent>
        <Footer>
            <button class="btn btn-sm btn-primary" @onclick="SaveEventAsync">@L["Save"]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">@L["Cancel"]</button>
        </Footer>
    </Modal>

    <div class="list-content">
        @if (events.Any())
        {
            @foreach (var evt in events)
            {
                var isConfirmingDelete = _pendingDeleteId == evt.Id;
                var isDeleting = _deletingEventIds.Contains(evt.Id);
                <div class="event-item @(isDeleting ? "deleting" : string.Empty)" @key="evt.Id">
                    <div class="event-info">
                        <div class="event-title">@evt.Content</div>
                        <div class="event-time">
                            @FormatEventTimeRange(evt.StartTime, evt.EndTime)
                        </div>
                        @if (!string.IsNullOrEmpty(evt.Note))
                        {
                            <div class="event-note">@evt.Note</div>
                        }
                        @if (!string.IsNullOrEmpty(evt.From))
                        {
                            <div class="event-from">@string.Format(L["Source"], evt.From)</div>
                        }
                    </div>
                    <div class="event-actions">
                        <button class="icon-btn edit-btn" title="@L["Edit"]" @onclick="() => EditEvent(evt)">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M4 20h4l10-10a2.12 2.12 0 0 0-3-3L5 17v3zM14 7l3 3" />
                            </svg>
                        </button>
                        <button class="icon-btn delete-btn @(isConfirmingDelete ? "confirm" : string.Empty)"
                                title="@(isConfirmingDelete ? L["ConfirmDelete"] : L["Delete"])"
                                @onclick="() => OnDeleteClickAsync(evt.Id)"
                                disabled="@isDeleting">
                            @if (isConfirmingDelete)
                            {
                                <span class="delete-confirm-mark">?</span>
                            }
                            else
                            {
                                <svg class="trash-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M9 3.5a1 1 0 0 0-1 1V6H5a1 1 0 1 0 0 2h.56l.9 10.2A2 2 0 0 0 8.45 20h7.1a2 2 0 0 0 1.99-1.8l.9-10.2H19a1 1 0 1 0 0-2h-3V4.5a1 1 0 0 0-1-1H9Zm2 2h2V6h-2V5.5ZM8.46 8h7.08l-.88 10H9.34L8.46 8Zm2.04 1.5a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Zm3 0a1 1 0 0 0-1 1v5a1 1 0 1 0 2 0v-5a1 1 0 0 0-1-1Z" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">@L["NoEvents"]</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateOnly SelectedDate { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<CalendarEvent> events = new();
    private bool isEditing;
    private long? editingId;
    private string editingContent = string.Empty;
    private DateTime editingStartTime = DateTime.Now;
    private DateTime editingEndTime = DateTime.Now.AddHours(1);
    private string editingNote = string.Empty;
    private long? _pendingDeleteId;
    private readonly HashSet<long> _deletingEventIds = [];
    private const int DeleteFadeOutDurationMs = 220;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        var result = await ReQuantumService.GetEventsByDateAsync(new GetEventsByDateRequest(SelectedDate));
        events = result.IsSuccess ? result.Value!.Events : [];
        _pendingDeleteId = null;
        _deletingEventIds.Clear();
    }

    private void ShowAddEventDialog()
    {
        editingId = null;
        editingContent = string.Empty;
        editingStartTime = SelectedDate.ToDateTime(new TimeOnly(9, 0));
        editingEndTime = SelectedDate.ToDateTime(new TimeOnly(10, 0));
        editingNote = string.Empty;
        isEditing = true;
    }

    private void EditEvent(CalendarEvent evt)
    {
        editingId = evt.Id;
        editingContent = evt.Content;
        editingStartTime = evt.StartTime;
        editingEndTime = evt.EndTime;
        editingNote = evt.Note;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = null;
        editingContent = string.Empty;
        editingStartTime = DateTime.Now;
        editingEndTime = DateTime.Now.AddHours(1);
        editingNote = string.Empty;
    }

    private async Task SaveEventAsync()
    {
        var content = editingContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        if (editingEndTime <= editingStartTime)
        {
            return;
        }

        var note = editingNote.Trim();
        if (editingId.HasValue)
        {
            await ReQuantumService.UpdateEventAsync(new UpdateEventRequest(editingId.Value, content, editingStartTime, editingEndTime, note));
        }
        else
        {
            await ReQuantumService.AddEventAsync(new AddEventRequest(content, editingStartTime, editingEndTime, note, "manual", 0));
        }

        CancelEdit();
        await LoadEventsAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task OnDeleteClickAsync(long id)
    {
        if (_deletingEventIds.Contains(id))
        {
            return;
        }

        if (_pendingDeleteId != id)
        {
            _pendingDeleteId = id;
            return;
        }

        _pendingDeleteId = null;
        _deletingEventIds.Add(id);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(DeleteFadeOutDurationMs);
        await DeleteEventAsync(id);
        _deletingEventIds.Remove(id);
    }

    private async Task DeleteEventAsync(long id)
    {
        await ReQuantumService.RemoveEventAsync(new RemoveEventRequest(id));
        await LoadEventsAsync();
        await OnChanged.InvokeAsync();
    }

    private static string FormatEventTimeRange(DateTime startTime, DateTime endTime)
    {
        return startTime.Date == endTime.Date
            ? $"{startTime:yyyy-MM-dd HH:mm} - {endTime:HH:mm}"
            : $"{startTime:yyyy-MM-dd HH:mm} - {endTime:yyyy-MM-dd HH:mm}";
    }
}
