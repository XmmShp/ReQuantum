@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@using ReQuantum.Contract.Calendar
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<div class="month-calendar">
    <div class="month-layout">
        <div class="month-main">
            <div class="calendar-grid">
                <div class="weekday-header">
                    <div class="weekday">@L["Sun"]</div>
                    <div class="weekday">@L["Mon"]</div>
                    <div class="weekday">@L["Tue"]</div>
                    <div class="weekday">@L["Wed"]</div>
                    <div class="weekday">@L["Thu"]</div>
                    <div class="weekday">@L["Fri"]</div>
                    <div class="weekday">@L["Sat"]</div>
                </div>

                <div class="days-viewport @(_isLoadingMonthData ? "loading" : string.Empty)">
                    @if (_isMonthTransitioning && _previousCalendarDays.Count > 0)
                    {
                        <div class="days-track @_monthTransitionClass" style="@GetDaysTrackStyle()" @key="_monthAnimationKey">
                            @if (_monthTransitionClass == "slide-up")
                            {
                                <div class="days-grid transition-grid">
                                    @foreach (var day in _previousCalendarDays)
                                    {
                                        var previousDayData = GetDayData(day, _previousDayDataMap);
                                        <div class="day-cell @GetDayClass(day, _previousFirstDayOfMonth, _previousLastDayOfMonth, includeSelected: false)" @onclick="() => SelectDay(day)">
                                            <div class="day-number">@day.Day</div>
                                            <div class="day-preview">
                                                @foreach (var previewItem in GetPreviewItems(day, previousDayData))
                                                {
                                                    <div class="preview-item @(previewItem.IsEvent ? "event" : "todo")">
                                                        <span class="preview-dot" aria-hidden="true"></span>
                                                        <span class="preview-text">@previewItem.DisplayText</span>
                                                    </div>
                                                }
                                                @if (GetRemainingPreviewCount(previousDayData) > 0)
                                                {
                                                    <div class="preview-item remaining">@string.Format(L["RemainingEvents"], GetRemainingPreviewCount(previousDayData))</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="days-grid transition-grid">
                                    @foreach (var day in _transitionCalendarDays)
                                    {
                                        var dayData = GetDayData(day, _previousDayDataMap);
                                        <div class="day-cell @GetDayClass(day, _firstDayOfMonth, _lastDayOfMonth)" @onclick="() => SelectDay(day)">
                                            <div class="day-number">@day.Day</div>
                                            <div class="day-preview">
                                                @foreach (var previewItem in GetPreviewItems(day, dayData))
                                                {
                                                    <div class="preview-item @(previewItem.IsEvent ? "event" : "todo")">
                                                        <span class="preview-dot" aria-hidden="true"></span>
                                                        <span class="preview-text">@previewItem.DisplayText</span>
                                                    </div>
                                                }
                                                @if (GetRemainingPreviewCount(dayData) > 0)
                                                {
                                                    <div class="preview-item remaining">@string.Format(L["RemainingEvents"], GetRemainingPreviewCount(dayData))</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="days-grid transition-grid">
                                    @foreach (var day in _transitionCalendarDays)
                                    {
                                        var dayData = GetDayData(day, _previousDayDataMap);
                                        <div class="day-cell @GetDayClass(day, _firstDayOfMonth, _lastDayOfMonth)" @onclick="() => SelectDay(day)">
                                            <div class="day-number">@day.Day</div>
                                            <div class="day-preview">
                                                @foreach (var previewItem in GetPreviewItems(day, dayData))
                                                {
                                                    <div class="preview-item @(previewItem.IsEvent ? "event" : "todo")">
                                                        <span class="preview-dot" aria-hidden="true"></span>
                                                        <span class="preview-text">@previewItem.DisplayText</span>
                                                    </div>
                                                }
                                                @if (GetRemainingPreviewCount(dayData) > 0)
                                                {
                                                    <div class="preview-item remaining">@string.Format(L["RemainingEvents"], GetRemainingPreviewCount(dayData))</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="days-grid transition-grid">
                                    @foreach (var day in _previousCalendarDays)
                                    {
                                        var previousDayData = GetDayData(day, _previousDayDataMap);
                                        <div class="day-cell @GetDayClass(day, _previousFirstDayOfMonth, _previousLastDayOfMonth, includeSelected: false)" @onclick="() => SelectDay(day)">
                                            <div class="day-number">@day.Day</div>
                                            <div class="day-preview">
                                                @foreach (var previewItem in GetPreviewItems(day, previousDayData))
                                                {
                                                    <div class="preview-item @(previewItem.IsEvent ? "event" : "todo")">
                                                        <span class="preview-dot" aria-hidden="true"></span>
                                                        <span class="preview-text">@previewItem.DisplayText</span>
                                                    </div>
                                                }
                                                @if (GetRemainingPreviewCount(previousDayData) > 0)
                                                {
                                                    <div class="preview-item remaining">@string.Format(L["RemainingEvents"], GetRemainingPreviewCount(previousDayData))</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="days-grid @(_isDataFadingIn ? "data-fade-in" : string.Empty)" @key="_dataFadeKey">
                            @foreach (var day in _calendarDays)
                            {
                                var dayData = GetDayData(day, _dayDataMap);
                                <div class="day-cell @GetDayClass(day, _firstDayOfMonth, _lastDayOfMonth)" @onclick="() => SelectDay(day)">
                                    <div class="day-number">@day.Day</div>
                                    <div class="day-preview">
                                        @foreach (var previewItem in GetPreviewItems(day, dayData))
                                        {
                                            <div class="preview-item @(previewItem.IsEvent ? "event" : "todo")">
                                                <span class="preview-dot" aria-hidden="true"></span>
                                                <span class="preview-text">@previewItem.DisplayText</span>
                                            </div>
                                        }
                                        @if (GetRemainingPreviewCount(dayData) > 0)
                                        {
                                            <div class="preview-item remaining">@string.Format(L["RemainingEvents"], GetRemainingPreviewCount(dayData))</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="selected-day-panels">
            <div class="selected-date-badge">@SelectedDate.ToString("yyyy-MM-dd")</div>
            <EventList SelectedDate="SelectedDate" OnChanged="RefreshCalendarDataAsync" />
            <TodoList SelectedDate="SelectedDate" OnChanged="RefreshCalendarDataAsync" />
            <NoteList OnChanged="RefreshCalendarDataAsync" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public DateOnly SelectedDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter]
    public EventCallback<DateOnly> SelectedDateChanged { get; set; }

    private DateTime _currentMonth = DateTime.Today;
    private DateOnly _firstDayOfMonth;
    private DateOnly _lastDayOfMonth;
    private readonly List<DateOnly> _calendarDays = [];
    private readonly Dictionary<DateOnly, CalendarDayData> _dayDataMap = [];

    protected override async Task OnInitializedAsync()
    {
        GenerateCalendarDays();
        await LoadMonthDataAsync();
        await EnsureDayDataLoadedAsync(SelectedDate);
    }

    protected override async Task OnParametersSetAsync()
    {
        var targetMonth = SelectedDate.ToDateTime(TimeOnly.MinValue);
        if (_currentMonth.Year != targetMonth.Year || _currentMonth.Month != targetMonth.Month)
        {
            await TransitionToMonthAsync(targetMonth);
        }

        if (!_isLoadingMonthData)
        {
            await EnsureDayDataLoadedAsync(SelectedDate);
        }
    }

    private void GenerateCalendarDays()
    {
        _calendarDays.Clear();

        var year = _currentMonth.Year;
        var month = _currentMonth.Month;

        _firstDayOfMonth = new DateOnly(year, month, 1);
        _lastDayOfMonth = _firstDayOfMonth.AddMonths(1).AddDays(-1);

        var firstDayOfWeek = (int)_firstDayOfMonth.DayOfWeek;
        var startDate = _firstDayOfMonth.AddDays(-firstDayOfWeek);

        for (int i = 0; i < 42; i++)
        {
            _calendarDays.Add(startDate.AddDays(i));
        }
    }

    private string GetDayClass(DateOnly day, DateOnly targetFirstDayOfMonth, DateOnly targetLastDayOfMonth, bool includeSelected = true)
    {
        var classes = new List<string>();

        if (day < targetFirstDayOfMonth || day > targetLastDayOfMonth)
        {
            classes.Add("other-month");
        }

        if (day == DateOnly.FromDateTime(DateTime.Today))
        {
            classes.Add("today");
        }

        if (includeSelected && day == SelectedDate)
        {
            classes.Add("selected");
        }

        return string.Join(" ", classes);
    }

    private async Task SelectDay(DateOnly day)
    {
        SelectedDate = day;

        if (day.Month == _currentMonth.Month && day.Year == _currentMonth.Year)
        {
            await EnsureDayDataLoadedAsync(day);
        }

        await SelectedDateChanged.InvokeAsync(day);
    }

    private static CalendarDayData GetDayData(DateOnly day, IReadOnlyDictionary<DateOnly, CalendarDayData> dayDataMap)
    {
        return dayDataMap.TryGetValue(day, out var dayData)
            ? dayData
            : new CalendarDayData(day, [], [], []);
    }

    private static IEnumerable<CalendarPreviewItem> GetPreviewItems(DateOnly day, CalendarDayData dayData)
    {
        var eventItems = dayData.Events
            .Select(evt => new CalendarPreviewItem(
                evt.StartTime,
                evt.StartTime.Date == day.ToDateTime(TimeOnly.MinValue).Date
                    ? $"{evt.StartTime:HH:mm} {evt.Content}"
                    : evt.Content,
                IsEvent: true));
        var todoItems = dayData.Todos
            .Select(todo => new CalendarPreviewItem(
                todo.DueTime,
                todo.Content,
                IsEvent: false));

        return eventItems
            .Concat(todoItems)
            .OrderBy(item => item.When)
            .Take(3);
    }

    private static int GetRemainingPreviewCount(CalendarDayData dayData)
    {
        var totalCount = dayData.Events.Count + dayData.Todos.Count;
        return totalCount > 3
            ? totalCount - 3
            : 0;
    }

    private readonly record struct CalendarPreviewItem(DateTime When, string DisplayText, bool IsEvent);

    private async Task LoadMonthDataAsync()
    {
        if (!_calendarDays.Any())
        {
            return;
        }

        var startDate = _calendarDays.Min().AddDays(-42);
        var endDate = _calendarDays.Max().AddDays(42);
        var result = await ReQuantumService.GetCalendarRangeDataAsync(new GetCalendarRangeDataRequest(startDate, endDate));
        if (!result.IsSuccess || result.Value is null)
        {
            return;
        }

        var nextDayDataMap = new Dictionary<DateOnly, CalendarDayData>();
        foreach (var kvp in result.Value.DataByDate)
        {
            nextDayDataMap[kvp.Key] = kvp.Value;
        }

        _dayDataMap.Clear();
        foreach (var kvp in nextDayDataMap)
        {
            _dayDataMap[kvp.Key] = kvp.Value;
        }
    }

    private async Task EnsureDayDataLoadedAsync(DateOnly day)
    {
        if (_dayDataMap.ContainsKey(day))
        {
            return;
        }

        var result = await ReQuantumService.GetCalendarRangeDataAsync(new GetCalendarRangeDataRequest(day, day));
        if (result is { IsSuccess: true, Value: not null } && result.Value.DataByDate.TryGetValue(day, out var dayData))
        {
            _dayDataMap[day] = dayData;
        }
    }

    private async Task RefreshCalendarDataAsync()
    {
        await LoadMonthDataAsync();
        await EnsureDayDataLoadedAsync(SelectedDate);
        await InvokeAsync(StateHasChanged);
    }
}
