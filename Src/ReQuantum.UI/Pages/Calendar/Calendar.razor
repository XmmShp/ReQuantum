@page "/calendar"
@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<PageTitle>@L["Calendar"]</PageTitle>

<div class="calendar-container">
    <div class="calendar-header @(_currentView == CalendarView.Month ? "month-view-header" : string.Empty)">
        <div class="date-switcher">
            <button class="btn btn-outline-secondary" @onclick="PreviousDate">&lt;</button>
            <span class="selected-date-label">@GetDateSwitcherLabel()</span>
            <button class="btn btn-outline-secondary" @onclick="NextDate">&gt;</button>
            <button class="btn btn-outline-primary" @onclick="GoToToday">@L["Today"]</button>
        </div>
        <div class="view-switcher">
            <button class="btn @(_currentView == CalendarView.Month ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => SwitchView(CalendarView.Month)">
                @L["MonthView"]
            </button>
            <button class="btn @(_currentView == CalendarView.Week ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => SwitchView(CalendarView.Week)">
                @L["WeekView"]
            </button>
        </div>
    </div>

    <div class="calendar-content">
        @if (_currentView == CalendarView.Month)
        {
            <MonthCalendar @bind-SelectedDate="_selectedDate" ShowHeader="false" />
        }
        else
        {
            <WeekCalendar @bind-SelectedDate="_selectedDate" ShowHeader="false" />
        }
    </div>
</div>

@code {
    private enum CalendarView
    {
        Month,
        Week
    }

    private CalendarView _currentView = CalendarView.Month;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);

    private void SwitchView(CalendarView view)
    {
        _currentView = view;
    }

    private void PreviousDate()
    {
        _selectedDate = _currentView switch
        {
            CalendarView.Month => _selectedDate.AddMonths(-1),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NextDate()
    {
        _selectedDate = _currentView switch
        {
            CalendarView.Month => _selectedDate.AddMonths(1),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void GoToToday()
    {
        _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private string GetDateSwitcherLabel()
    {
        return _currentView switch
        {
            CalendarView.Month => _selectedDate.ToString("yyyy/MM"),
            _ => $"{GetCurrentWeekStart():yyyy-MM-dd} ~ {GetCurrentWeekStart().AddDays(6):yyyy-MM-dd}"
        };
    }

    private DateOnly GetCurrentWeekStart()
    {
        var offset = (int)_selectedDate.DayOfWeek;
        return _selectedDate.AddDays(-offset);
    }
}
