@page "/calendar"
@using Microsoft.Extensions.Localization
@using ReQuantum.Contract
@using ReQuantum.Shared.Resources.Localization
@inject IStringLocalizer<CalendarStrings> L
@inject IReQuantumService ReQuantumService

<PageTitle>@L["Calendar"]</PageTitle>

<div class="calendar-container">
    <div class="calendar-header @(currentView == CalendarView.Month ? "month-view-header" : string.Empty)">
        <div class="date-switcher">
            <button class="btn btn-outline-secondary" @onclick="PreviousDate">&lt;</button>
            <span class="selected-date-label">@GetDateSwitcherLabel()</span>
            <button class="btn btn-outline-secondary" @onclick="NextDate">&gt;</button>
            <button class="btn btn-outline-primary" @onclick="GoToToday">@L["Today"]</button>
        </div>
        <div class="view-switcher">
            <button class="btn @(currentView == CalendarView.Month ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => SwitchView(CalendarView.Month)">
                @L["MonthView"]
            </button>
            <button class="btn @(currentView == CalendarView.Week ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => SwitchView(CalendarView.Week)">
                @L["WeekView"]
            </button>
            <button class="btn @(currentView == CalendarView.List ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="() => SwitchView(CalendarView.List)">
                @L["ListView"]
            </button>
        </div>
    </div>

    <div class="calendar-content">
        @if (currentView == CalendarView.Month)
        {
            <MonthCalendar @bind-SelectedDate="selectedDate" ShowHeader="false" />
        }
        else if (currentView == CalendarView.Week)
        {
            <WeekCalendar @bind-SelectedDate="selectedDate" ShowHeader="false" />
        }
        else if (currentView == CalendarView.List)
        {
            <div class="list-view-container">
                <EventList SelectedDate="selectedDate" />
                <TodoList SelectedDate="selectedDate" />
                <NoteList />
            </div>
        }
    </div>
</div>

@code {
    private enum CalendarView
    {
        Month,
        Week,
        List
    }

    private CalendarView currentView = CalendarView.Month;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);

    private void SwitchView(CalendarView view)
    {
        currentView = view;
    }

    private void PreviousDate()
    {
        selectedDate = currentView switch
        {
            CalendarView.Month => selectedDate.AddMonths(-1),
            CalendarView.Week => selectedDate.AddDays(-7),
            _ => selectedDate.AddDays(-1)
        };
    }

    private void NextDate()
    {
        selectedDate = currentView switch
        {
            CalendarView.Month => selectedDate.AddMonths(1),
            CalendarView.Week => selectedDate.AddDays(7),
            _ => selectedDate.AddDays(1)
        };
    }

    private void GoToToday()
    {
        selectedDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private string GetDateSwitcherLabel()
    {
        return currentView switch
        {
            CalendarView.Month => selectedDate.ToString("yyyy/MM"),
            CalendarView.Week => $"{GetCurrentWeekStart():yyyy-MM-dd} ~ {GetCurrentWeekStart().AddDays(6):yyyy-MM-dd}",
            _ => selectedDate.ToString("yyyy-MM-dd")
        };
    }

    private DateOnly GetCurrentWeekStart()
    {
        var offset = (int)selectedDate.DayOfWeek;
        return selectedDate.AddDays(-offset);
    }
}
